{
  "type": "record",
  "name": "MoexTqbrEvent",
  "namespace": "course.bigdata.moex",
  "doc": "ЛР2, вариант №12: marketdata TQBR. Avro v1 хранит все выявленные поля источника, кроме NUMTRADES: оно специально исключено для эволюции v2. Для всех числовых показателей допускается null; типы полей с одними null предварительные.",
  "fields": [
    {
      "name": "event_key",
      "type": "string",
      "doc": "Идемпотентный ключ события: TQBR + SECID + UTC-время."
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "SYSTIME, приведённое из MSK к миллисекундам Unix UTC."
    },
    {
      "name": "received_at",
      "type": "string",
      "doc": "Время получения сборщиком, ISO 8601 UTC."
    },
    {
      "name": "source",
      "type": "string",
      "doc": "Источник данных: moex."
    },
    {
      "name": "SECID",
      "type": "string",
      "doc": "Код ценной бумаги"
    },
    {
      "name": "BOARDID",
      "type": "string",
      "doc": "Код режима торгов TQBR"
    },
    {
      "name": "BID",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Лучшая цена заявки на покупку"
    },
    {
      "name": "BIDDEPTH",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Глубина спроса; в выборке только null, тип предварительный"
    },
    {
      "name": "OFFER",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Лучшая цена заявки на продажу"
    },
    {
      "name": "OFFERDEPTH",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Глубина предложения; в выборке только null, тип предварительный"
    },
    {
      "name": "SPREAD",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Разница цены продажи и покупки"
    },
    {
      "name": "BIDDEPTHT",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Суммарный объём заявок на покупку"
    },
    {
      "name": "OFFERDEPTHT",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Суммарный объём заявок на продажу"
    },
    {
      "name": "OPEN",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Цена открытия"
    },
    {
      "name": "LOW",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Минимальная цена торгового периода"
    },
    {
      "name": "HIGH",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Максимальная цена торгового периода"
    },
    {
      "name": "LAST",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Цена последней сделки"
    },
    {
      "name": "LASTCHANGE",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Абсолютное изменение последней цены"
    },
    {
      "name": "LASTCHANGEPRCNT",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Процентное изменение последней цены"
    },
    {
      "name": "QTY",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Объём последней сделки"
    },
