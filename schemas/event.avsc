      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "Расчётная цена ETF; в выборке только null, тип предварительный"
    },
    {
      "name": "TRADINGSTATUS",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Статус торгов"
    },
